function UndeadThralls()
    return SpellId('Target_AnimateDead_YMS_Skeleton')
    | SpellId('Target_AnimateDead_YMS_Skeleton_4')
    | SpellId('Target_AnimateDead_YMS_Skeleton_5')
    | SpellId('Target_AnimateDead_YMS_Skeleton_6')
    | SpellId('Target_AnimateDead_YMS_Zombie')
    | SpellId('Target_AnimateDead_YMS_Zombie_4')
    | SpellId('Target_AnimateDead_YMS_Zombie_5')
    | SpellId('Target_AnimateDead_YMS_Zombie_6')
end

function WondrousAlteration()
    return SpellId('Shout_AlterSelf')
end

function EmpoweredTransmutation()
    return IsSpellOfSchool(SpellSchool.Transmutation) & ~IsCantrip()
end

function ShapeShifter()
    return SpellId('Target_Polymorph')
end